# Playwright Test Environment Configuration
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Update values below with your actual credentials
# 3. .env is gitignored and safe for real credentials

# Browser settings
HEADED=false
CI=false

# Test configuration
PLAYWRIGHT_WORKERS=4
RETRY_COUNT=1

# Debug settings
DEBUG=false
SLOW_MO=0

# ============================================
# TEST USER CREDENTIALS
# ============================================
# Email format is auto-generated from country in code:
# mach.hws.testuser.{country}@yopmail.com
# Example for SITE_COUNTRY=no -> mach.hws.testuser.no@yopmail.com
#
# Shared password for all generated test users.
# Set this in .env (local) and pipeline variables (CI/CD).
TEST_USER_PASSWORD=
COMMERCETOOLS_BASIC_AUTH=

# Storefront HTTP basic authentication
STOREFRONT_USERNAME=storefront
STOREFRONT_DEV_PASSWORD=''
STOREFRONT_STG_PASSWORD=''
