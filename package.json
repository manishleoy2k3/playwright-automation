{
  "name": "PlayWrightAutomation",
  "version": "1.0.0",
  "description": "TypeScript test automation framework using Playwright with Page Object Model, Allure reporting, and Azure DevOps CI/CD",
  "main": "index.js",
  "scripts": {
    "regression": "npx playwright test",
    "webTests": "npx playwright test --grep @Web",
    "APITests": "npx playwright test --grep @API",
    "SafariNewConfig": "npx playwright test --config playwright.config1.js --project=safari",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:e2e": "playwright test e2e/",
    "test:features": "playwright test features/",
    "test:local-dev": "SITE_ENV=dev SITE_COUNTRY=de SITE_LANGUAGE=de playwright test --project=chromium --headed --reporter=allure-playwright; npm run allure:generate && npm run allure:open",
    "test:local-ui": "SITE_ENV=stg SITE_COUNTRY=cz playwright test --ui",
    "report": "playwright show-report",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf test-results allure-results allure-report playwright-report",
    "precommit": "npm run type-check && npm run lint && npm run format:check",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "page-object-model",
    "allure",
    "e2e-testing",
    "ui-testing"
  ],
  "author": "Test Automation Engineer",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.40.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "allure-commandline": "^2.24.1",
    "allure-playwright": "^2.8.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-playwright": "^1.8.0",
    "globals": "^15.13.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.3",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "@alex_neo/playwright-azure-reporter": "^1.19.0"
  }
}
