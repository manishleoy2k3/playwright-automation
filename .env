# Playwright Test Environment Configuration
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the TEST_USER_* values below with your actual test credentials
# 3. .env is gitignored and safe for real credentials

# Environment selection (dev=development, qa=quality assurance)
SITE_ENV=dev

# Country code (ISO 2-letter code, lowercase)
SITE_COUNTRY=de

# Language code (2-letter language code, lowercase)
SITE_LANGUAGE=de

# Alternative: Set complete BASE_URL (overrides above settings)
# Example BASE_URL (will be built dynamically by URL builder)
# BASE_URL=<add your base URL here>

# Browser settings
HEADED=false
CI=false

# Test configuration
PLAYWRIGHT_WORKERS=4
RETRY_COUNT=1

# Debug settings
DEBUG=false
SLOW_MO=0

# ============================================
# TEST USER CREDENTIALS
# ============================================
# Email format is auto-generated from country in code:
# mach.hws.testuser.{country}@yopmail.com
# Example for SITE_COUNTRY=no -> mach.hws.testuser.no@yopmail.com
#
# Shared password for all generated test users.
# Set this in .env (local) and pipeline variables (CI/CD).
TEST_USER_PASSWORD=<add Test User password here>
COMMERCETOOLS_BASIC_AUTH=
STOREFRONT_USERNAME='storefront'
STOREFRONT_DEV_PASSWORD='<add password here>'
STOREFRONT_STG_PASSWORD='<add password here>'
